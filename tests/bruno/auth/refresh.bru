meta {
  name: Refresh Token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("accessToken", res.body.access_token);
  }
}

docs {
  Run when a request returns 401 "Token expired" — access tokens last 60 minutes.
  Login/Register scripts capture refreshToken automatically; this mints a fresh accessToken.
}
