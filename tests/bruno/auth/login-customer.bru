meta {
  name: Login Customer
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "buyer@test.com",
    "password": "buyer123"
  }
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("accessToken", res.body.access_token);
  }
}
