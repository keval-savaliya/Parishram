meta {
  name: Admin List Enquiries
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/enquiries
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body && res.body.length) {
    bru.setEnvVar("enquiryId", res.body[0].enquiry_id);
  }
}
